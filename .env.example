# Copiar a .env (no versionado) y rellenar. Una pareja por cada `id` de config/jenkins.yaml.
# En el laboratorio local los genera `python -m lab.bootstrap up`.
JENKINS_DEV_USER=
JENKINS_DEV_TOKEN=
JENKINS_PRE_USER=
JENKINS_PRE_TOKEN=
JENKINS_PRO_USER=
JENKINS_PRO_TOKEN=

# Opcional: ruta alternativa al fichero de configuración
# JOB_ENABLER_CONFIG=config/jenkins.yaml
